{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=store;Username=store;Password=store"
  },
  "Jwt": {
    "Issuer": "Store.Api",
    "Audience": "Store.Client",
    "AccessTokenMinutes": 20,
    "RefreshTokenDays": 14
  },
  "FileStorage": {
    "RootPath": "wwwroot/uploads/products",
    "PublicBasePath": "/uploads/products"
  },
  "AdminSeed": {
    "Email": "admin@store.local",
    "FullName": "Store Admin"
  },
  "AllowedHosts": "*"
}
